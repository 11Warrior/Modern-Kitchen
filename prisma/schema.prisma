generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//Users, Chef and Meetings

model Client {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  FirstName String?
  LastName  String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime  @updatedAt

  meetings Meeting[]


  @@map("Clients")
}

model Chef {
  id           String   @id @default(cuid())
  clerkId      String   @unique
  email        String   @unique
  name         String?
  profileImage String
  phone        String?
  gender       Gender
  bio          String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  meetings Meeting[]

    @@map("Chefs")
}

model Meeting {
  id    String      @id @default(cuid())
  date  DateTime  
  time String
  duration Int    @default(40)
  notes String?

  clientId String
  chefId String


  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  chef Chef @relation(fields: [chefId], references: [id], onDelete: Cascade)


  @@map("Meetings")
}


enum Gender {
  MALE
  FEMALE
}
